<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ .Demo.Title }} — booba</title>
<link rel="icon" type="image/png" href="{{ .Base }}/_assets/booba.png">
<link rel="stylesheet" href="{{ .Base }}/style.css">
</head>
<body class="layout">
<button class="menu-button" aria-label="Toggle navigation">☰</button>
<div class="sidebar-overlay"></div>
{{ template "sidebar" . }}
<main class="main">
  <header class="demo-header">
    <h1>{{ .Demo.Title }}</h1>
    <p class="demo-blurb">{{ .Demo.BlurbHTML }}</p>
    <a class="demo-source-link" href="{{ .Demo.SourceURL }}">Source on GitHub →</a>
    {{ if not .Demo.BrowserOnly }}
    <div class="demo-run">
      <p>Run it natively from a checkout of go-booba:</p>
      <pre><code>{{ .Demo.RunCommand }}</code></pre>
    </div>
    {{ end }}
  </header>
  {{ .ExtraBody }}
  {{ if not .Demo.BrowserOnly }}
  <div class="demo-program-row">
    <section class="demo-status"></section>
    <button id="restart" class="demo-restart" type="button" disabled>Restart program</button>
  </div>
  {{ end }}
  <section class="terminal-frame">
    <div id="terminal"></div>
  </section>
</main>
{{ if not .Demo.BrowserOnly }}<script src="{{ .Base }}/_assets/wasm_exec.js"></script>{{ end }}
{{ .ExtraScript }}
<script type="module">
  // A fragment can set demoOptions and demoSetup to customize the terminal.
  // Browser-only demos connect their local adapter in demoSetup.
  import {
    BoobaTerminal,
    installRendererHud,
    installStatusBar,
    parseRendererFromURL,
  } from "{{ .Base }}/_assets/booba/booba.js";

  {{ if not .Demo.BrowserOnly }}
  async function run(booba, module) {
    const go = new Go();
    const instance = await WebAssembly.instantiate(module, go.importObject);
    go.run(instance);
    booba.connectWasm();
    booba.focus();
  }
  {{ end }}

  async function main() {
    {{ if not .Demo.BrowserOnly }}
    const module = await WebAssembly.compileStreaming(fetch("./app.wasm"));
    {{ end }}

    const booba = new BoobaTerminal("terminal", {
      renderer: parseRendererFromURL(),
      ...(window.demoOptions ?? {}),
    });
    await booba.init();
    {{ if not .Demo.BrowserOnly }}
    // Program status (OSC 7501) from the demo, shown outside the canvas.
    installStatusBar(booba.programStatus, {
      parent: document.querySelector(".demo-status"),
      onLayout: () => booba.fitAddon?.fit(),
    });
    {{ end }}
    if (typeof window.demoSetup === "function") {
      await window.demoSetup(booba);
    }
    {{ if not .Demo.BrowserOnly }}
    await run(booba, module);

    const restart = document.getElementById("restart");
    restart.addEventListener("click", async () => {
      restart.disabled = true;
      try {
        // A program that is still running keeps its runtime alive after the
        // page stops listening, so ask it to quit first (both demos quit on
        // Ctrl+C) and give it a moment to return.
        if (window.bubbletea_exited !== true) {
          booba.input("\x03");
          for (let i = 0; i < 20 && window.bubbletea_exited !== true; i++) {
            await new Promise(resolve => setTimeout(resolve, 50));
          }
        }
        booba.disconnect();
        booba.reset();
        await run(booba, module);
      } catch (error) {
        console.error(error);
        booba.writeln(String(error));
      } finally {
        restart.disabled = false;
      }
    });
    restart.disabled = false;
    {{ end }}

    const frame = document.querySelector(".terminal-frame");
    installRendererHud(booba.term, {
      parent: frame ?? undefined,
      position: "absolute",
      className: "demo-renderer-hud",
      bindToggleHotkey: false,
    });
  }

  main().catch(error => {
    console.error(error);
    const target = document.getElementById("status") ?? document.getElementById("terminal");
    if (target) target.textContent = String(error);
  });
</script>
{{ template "menu-script" . }}
</body>
</html>
