# booba .gitignore

.task
.superpowers/
docs/superpowers/
.DS_Store
.zig-cache/
node_modules/

bin/
dist/
/booba
booba.exe
/booba-view-example
/completions/
/docs/man/

# serve/static/booba/ and serve/static/ntwebterm/ are generated but the
# runtime artifacts (.js, .wasm) are committed so the Go module is
# self-contained. Dev artifacts (.d.ts, .map) are excluded.
serve/static/booba/*.d.ts
serve/static/booba/*.d.ts.map
serve/static/booba/*.js.map
serve/static/ntwebterm/*
!serve/static/ntwebterm/ntwebterm.js
!serve/static/ntwebterm/ghostty-vt.wasm
!serve/static/ntwebterm/__vite-*.js

# git worktrees
.worktrees/

# Demo site output (cmd/wasm-build); sources under web/ are committed.
web/index.html
web/demos/
web/_assets/wasm_exec.js
web/_assets/index.html
web/_assets/booba/
web/_assets/ntwebterm/

web/_assets/ghostty-web/
